# ------------------------------------------------------------------
# DEVELOPMENT — SQLite (default, no external database needed)
# ------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------
# PRODUCTION — Neon (Postgres)
# Used by the Postgres schema variant (prisma/schema.postgres.prisma)
# generated/selected by `npm run db:push:prod` and the Vercel build.
# Example: postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# ------------------------------------------------------------------
# DATABASE_URL="postgresql://user:password@host:5432/vedika?sslmode=require"

# ------------------------------------------------------------------
# NextAuth
# ------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# PayU (India) — get from https://onboarding.payu.in
# Use test credentials for UAT, live credentials for production.
# ------------------------------------------------------------------
PAYU_KEY=""
PAYU_SALT=""
# "test" -> https://test.payu.in ; "live" -> https://secure.payu.in
PAYU_MODE="test"
